        descriptionKey:
          GlocText: item.description.fuse
          NormalText: "\uC804\uAE30 \uC7A5\uBE44\uB97C \uC218\uB9AC\uD558\uACE0 \uAE30\uACC4\uC5D0
            \uC804\uB825\uC744 \uACF5\uAE09\uD558\uB294 \uB370 \uD544\uC694\uD55C
            \uC544\uC774\uD15C\uC785\uB2C8\uB2E4. \uC791\uC544 \uC778\uBCA4\uD1A0\uB9AC\uC5D0
            \uB123\uC5B4 \uB2E4\uB2C8\uAE30 \uC27D\uC2B5\uB2C8\uB2E4."
