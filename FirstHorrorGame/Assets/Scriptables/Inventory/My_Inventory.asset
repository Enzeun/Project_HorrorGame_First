          GlocText: item.description.flashlight
          NormalText: "\uC5B4\uB450\uC6B4 \uACF3\uC744 \uBC1D\uD788\uACE0 \uC228\uC740
            \uC704\uD5D8\uC744 \uB4DC\uB7EC\uB0B4\uAE30\uC5D0 \uC88B\uC740, \uACAC\uACE0\uD55C
            \uAE08\uC18D \uBAB8\uCCB4\uC758 \uAC15\uB825\uD55C \uC190\uC804\uB4F1\uC785\uB2C8\uB2E4."
