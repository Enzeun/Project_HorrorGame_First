        titleKey:
          GlocText: item.title.lighter
          NormalText: "\uB77C\uC774\uD130"
        descriptionKey:
          GlocText: item.description.lighter
          NormalText: "\uC5B4\uB5A4 \uBAA8\uD5D8\uAC00\uC5D0\uAC8C\uB098 \uBBFF\uC74C\uC9C1\uD55C
            \uBD88\uC528\uC785\uB2C8\uB2E4. \uC791\uACE0 \uC0AC\uC6A9\uD558\uAE30
