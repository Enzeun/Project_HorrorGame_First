        titleKey:
          GlocText: item.title.key01
          NormalText: "\uC5F4\uC1E0 01"
        descriptionKey:
          GlocText: item.description.key01
          NormalText: "\uC5B4\uB514\uC5D0 \uC4F0\uC774\uB294\uC9C0 \uC54C \uC218
            \uC5C6\uB294 \uD3C9\uBC94\uD558\uC9C0\uB9CC \uC218\uC218\uAED8\uB07C
            \uAC19\uC740 \uC5F4\uC1E0\uC785\uB2C8\uB2E4. \uBB38, \uC0C1\uC790, \uC544\uC9C1
            \uBC1C\uACAC\uD558\uC9C0 \uBABB\uD55C \uBE44\uBC00\uC744 \uC5F4 \uC218\uB3C4
            \uC788\uC73C\uB2C8 \uC798 \uBCF4\uAD00\uD558\uC138\uC694."
