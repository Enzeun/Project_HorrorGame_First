  - EntryId: 86483556
    SectionId: 24283221
    Key: item.title.flashlight
    Value: "\uC190\uC804\uB4F1"
  - EntryId: 66394995
    SectionId: 24283221
    Key: item.description.flashlight
    Value: "\uC5B4\uB450\uC6B4 \uACF3\uC744 \uBC1D\uD788\uACE0 \uC228\uC740 \uC704\uD5D8\uC744
      \uB4DC\uB7EC\uB0B4\uAE30\uC5D0 \uC88B\uC740, \uACAC\uACE0\uD55C \uAE08\uC18D
      \uBAB8\uCCB4\uC758 \uAC15\uB825\uD55C \uC190\uC804\uB4F1\uC785\uB2C8\uB2E4."
  - EntryId: 27479224
    SectionId: 24283221
    Key: item.title.camcorder
    Value: "\uCEA0\uCF54\uB354"
  - EntryId: 13199872
    SectionId: 24283221
    Key: item.description.camcorder
    Value: "\uC5B4\uB460\uC744 \uBE44\uCD94\uC138\uC694. \uB098\uC774\uD2B8 \uBE44\uC804
      \uAE30\uB2A5\uC744 \uAC16\uCD98 \uC774 \uCEA0\uCF54\uB354\uB294 \uC5B4\uB450\uC6B4
      \uD658\uACBD\uC744 \uD0D0\uD5D8\uD558\uACE0 \uAE30\uB85D\uD558\uAE30\uC5D0
      \uC801\uD569\uD569\uB2C8\uB2E4."
  - EntryId: 52214045
    SectionId: 24283221
    Key: item.title.lantern
    Value: "\uB79C\uD134"
  - EntryId: 10453279
    SectionId: 24283221
    Key: item.description.lantern
    Value: "\uC5B4\uB5A4 \uBAA8\uD5D8\uAC00\uC5D0\uAC8C\uB098 \uBBFF\uC74C\uC9C1\uD55C
      \uAD11\uC6D0\uC785\uB2C8\uB2E4. \uBC1D\uACE0 \uC548\uC815\uC801\uC778 \uB79C\uD134
      \uBD88\uAF43\uC774 \uC8FC\uBCC0\uC744 \uD3B8\uC548\uD558\uAC8C \uBC1D\uD600
      \uC90D\uB2C8\uB2E4."
  - EntryId: 58743985
    SectionId: 24283221
    Key: item.title.lighter
    Value: "\uB77C\uC774\uD130"
  - EntryId: 35147977
    SectionId: 24283221
    Key: item.description.lighter
    Value: "\uC5B4\uB5A4 \uBAA8\uD5D8\uAC00\uC5D0\uAC8C\uB098 \uBBFF\uC74C\uC9C1\uD55C
      \uBD88\uC528\uC785\uB2C8\uB2E4. \uC791\uACE0 \uC0AC\uC6A9\uD558\uAE30 \uC26C\uC6CC
      \uAF2D \uCC59\uACA8\uC57C \uD560 \uC544\uC774\uD15C\uC785\uB2C8\uB2E4."
  - EntryId: 47759722
    SectionId: 24283221
    Key: item.title.candle
    Value: "\uC591\uCD08"
  - EntryId: 88800642
    SectionId: 24283221
    Key: item.description.candle
    Value: "\uC791\uC9C0\uB9CC \uC624\uB798 \uD0C0\uC624\uB974\uBA70, \uC5B4\uB460
      \uC18D\uC5D0\uC11C \uBE5B\uACFC \uC628\uAE30\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4."
  - EntryId: 64813928
    SectionId: 24283221
    Key: item.title.axe
    Value: "\uB3C4\uB07C"
  - EntryId: 81754557
    SectionId: 24283221
    Key: item.description.axe
    Value: "\uB0A0\uCE74\uB85C\uC6B4 \uAE08\uC18D \uB0A0\uACFC \uD2BC\uD2BC\uD55C
      \uB098\uBB34 \uC190\uC7A1\uC774\uAC00 \uB2EC\uB9B0 \uB3C4\uAD6C\uC785\uB2C8\uB2E4.
      \uC7A5\uC791\uC744 \uD328\uAC70\uB098 \uC704\uAE09\uD55C \uC0C1\uD669\uC5D0\uC11C
      \uC790\uC2E0\uC744 \uBC29\uC5B4\uD558\uAE30\uC5D0 \uC88B\uC2B5\uB2C8\uB2E4."
  - EntryId: 29595890
    SectionId: 24283221
    Key: item.title.pocketknife
    Value: "\uC811\uC774\uC2DD \uCE7C"
  - EntryId: 10912878
    SectionId: 24283221
    Key: item.description.pocketknife
    Value: "\uC808\uB2E8 \uC791\uC5C5\uACFC \uADFC\uC811 \uBC29\uC5B4\uC5D0 \uB450\uB8E8
      \uC4F8 \uC218 \uC788\uB294 \uC791\uC740 \uC811\uC774\uC2DD \uCE7C\uC785\uB2C8\uB2E4.
      \uC5B8\uC81C\uB098 \uCC59\uACA8 \uB450\uAE30 \uC88B\uC2B5\uB2C8\uB2E4."
  - EntryId: 53741014
    SectionId: 24283221
    Key: item.title.pistol
    Value: "\uAD8C\uCD1D"
  - EntryId: 19660599
    SectionId: 24283221
    Key: item.description.pistol
    Value: "\uADFC\uAC70\uB9AC \uC804\uD22C\uC5D0 \uBBFF\uC74C\uC9C1\uD55C \uBCF4\uC870
      \uBB34\uAE30\uC785\uB2C8\uB2E4. \uAC15\uB825\uD55C \uC704\uB825\uC744 \uC9C0\uB154\uC73C\uBA70
      \uC704\uD5D8\uD55C \uC0C1\uD669\uC5D0\uC11C \uBAA9\uC228\uC744 \uAD6C\uD574
      \uC904 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - EntryId: 61872019
    SectionId: 24283221
    Key: item.title.thermometer
    Value: "\uC628\uB3C4\uACC4"
  - EntryId: 78303727
    SectionId: 24283221
    Key: item.description.thermometer
    Value: "\uC8FC\uBCC0\uC758 \uC628\uB3C4\uB97C \uCE21\uC815\uD569\uB2C8\uB2E4.
      \uD658\uACBD \uBCC0\uD654\uB97C \uAC10\uC9C0\uD558\uB294 \uB370 \uC720\uC6A9\uD569\uB2C8\uB2E4."
  - EntryId: 58318911
    SectionId: 24283221
    Key: item.title.emfmeter
    Value: "EMF \uCE21\uC815\uAE30"
  - EntryId: 33905725
    SectionId: 24283221
    Key: item.description.emfmeter
    Value: "\uC804\uC790\uAE30\uC7A5\uC744 \uAC10\uC9C0\uD569\uB2C8\uB2E4. \uCD08\uC790\uC5F0
      \uD604\uC0C1\uC774\uB098 \uC804\uC790\uAE30 \uAD50\uB780\uC744 \uD30C\uC545\uD558\uB294
      \uB370 \uD544\uC218\uC801\uC778 \uB3C4\uAD6C\uC785\uB2C8\uB2E4. \uC720\uB839
      \uC0AC\uB0E5\uAFBC\uACFC \uC870\uC0AC\uAD00\uC5D0\uAC8C \uAF2D \uD544\uC694\uD569\uB2C8\uB2E4."
  - EntryId: 34833445
    SectionId: 24283221
    Key: item.title.firstaidkit
    Value: "\uC751\uAE09 \uCC98\uCE58 \uD0A4\uD2B8"
  - EntryId: 95076873
    SectionId: 24283221
    Key: item.description.firstaidkit
    Value: "\uD544\uC218 \uC758\uB8CC \uC6A9\uD488\uC774 \uB4E4\uC5B4 \uC788\uB294
      \uC0DD\uC874 \uB3C4\uAD6C\uC785\uB2C8\uB2E4. \uCCB4\uB825\uC744 \uD68C\uBCF5\uD558\uACE0
      \uAC00\uBCBC\uC6B4 \uBD80\uC0C1\uC744 \uCE58\uB8CC\uD560 \uC218 \uC788\uC5B4
      \uC751\uAE09 \uC0C1\uD669\uC5D0 \uC720\uC6A9\uD569\uB2C8\uB2E4."
  - EntryId: 44235869
    SectionId: 24283221
    Key: item.title.medicaloil
    Value: "\uC758\uB8CC\uC6A9 \uC624\uC77C"
  - EntryId: 59674130
    SectionId: 24283221
    Key: item.description.medicaloil
    Value: "\uB2E4\uC591\uD55C \uC9C8\uD658\uC744 \uC644\uD654\uD558\uACE0 \uD68C\uBCF5
      \uC18D\uB3C4\uB97C \uB192\uC774\uBA70 \uC704\uAE09\uD55C \uC21C\uAC04 \uCCB4\uB825\uC744
      \uBCF4\uCDA9\uD558\uB294 \uBE60\uB974\uAC8C \uC791\uC6A9\uD558\uB294 \uC57D\uD488\uC785\uB2C8\uB2E4."
  - EntryId: 39924894
    SectionId: 24283221
    Key: item.title.medicalherb
    Value: "\uC57D\uCD08"
  - EntryId: 10202328
    SectionId: 24283221
    Key: item.description.medicalherb
    Value: "\uCE58\uC720 \uD6A8\uB2A5\uC744 \uC9C0\uB2CC \uD76C\uADC0\uD558\uACE0
      \uAC15\uB825\uD55C \uC2DD\uBB3C\uC785\uB2C8\uB2E4. \uCCB4\uB825\uC744 \uC801\uB2F9\uD788
      \uD68C\uBCF5\uD558\uAC70\uB098 \uAC15\uB825\uD55C \uD68C\uBCF5 \uBB3C\uC57D\uACFC
      \uC57D\uC744 \uB9CC\uB4DC\uB294 \uB370 \uC0AC\uC6A9\uB429\uB2C8\uB2E4."
  - EntryId: 63867823
    SectionId: 24283221
    Key: item.title.healingpotion
    Value: "\uD68C\uBCF5 \uBB3C\uC57D"
  - EntryId: 42067171
    SectionId: 24283221
    Key: item.description.healingpotion
    Value: "\uC758\uB8CC\uC6A9 \uC624\uC77C\uACFC \uC57D\uCD08\uB85C \uB9CC\uB4E0
      \uAC15\uB825\uD55C \uD63C\uD569\uBB3C\uC785\uB2C8\uB2E4. \uCCB4\uB825\uC744
      \uBE60\uB974\uACE0 \uD06C\uAC8C \uD68C\uBCF5\uC2DC\uCF1C \uC90D\uB2C8\uB2E4."
  - EntryId: 16895552
    SectionId: 24283221
    Key: item.title.alkalinebattery
    Value: "\uC54C\uCE74\uB77C\uC778 \uBC30\uD130\uB9AC"
  - EntryId: 88078736
    SectionId: 24283221
    Key: item.description.alkalinebattery
    Value: "\uC190\uC804\uB4F1, \uB77C\uB514\uC624 \uB4F1 \uD544\uC218 \uC7A5\uBE44\uC5D0
      \uC624\uB798 \uC9C0\uC18D\uB418\uB294 \uC804\uB825\uC744 \uACF5\uAE09\uD558\uB294
      \uC791\uACE0 \uBBFF\uC74C\uC9C1\uD55C \uC804\uC6D0\uC785\uB2C8\uB2E4."
  - EntryId: 31902149
    SectionId: 24283221
    Key: item.title.camerabattery
    Value: "\uCEA0\uCF54\uB354 \uBC30\uD130\uB9AC"
  - EntryId: 14597581
    SectionId: 24283221
    Key: item.description.camerabattery
    Value: "\uCEA0\uCF54\uB354\uB97C \uACC4\uC18D \uCF1C \uB454 \uCC44 \uC0AC\uC6A9\uD560
      \uC218 \uC788\uAC8C \uD574 \uC8FC\uB294 \uBBFF\uC74C\uC9C1\uD55C \uBC30\uD130\uB9AC\uC785\uB2C8\uB2E4.
      \uC624\uB798 \uC9C0\uC18D\uB418\uB294 \uC804\uB825\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4."
  - EntryId: 68908540
    SectionId: 24283221
    Key: item.title.petroloil
    Value: "\uB4F1\uC720"
  - EntryId: 10772658
    SectionId: 24283221
    Key: item.description.petroloil
    Value: "\uB79C\uD134\uACFC \uB7A8\uD504\uC758 \uC5F0\uB8CC\uB85C \uD754\uD788
      \uC4F0\uC774\uB294 \uC815\uC81C \uC11D\uC720 \uC81C\uD488\uC785\uB2C8\uB2E4.
      \uB9D1\uACE0 \uBB34\uC0C9\uC774\uBA70, \uD0DC\uC6B0\uBA74 \uBC1D\uACE0 \uC548\uC815\uC801\uC778
      \uBD88\uAF43\uC744 \uB0C5\uB2C8\uB2E4."
  - EntryId: 26904931
    SectionId: 24283221
    Key: item.title.pistolammo
    Value: "\uAD8C\uCD1D \uD0C4\uC57D"
  - EntryId: 10323082
    SectionId: 24283221
    Key: item.description.pistolammo
    Value: "\uB2E4\uC591\uD55C \uCD1D\uAE30\uC5D0 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC791\uC9C0\uB9CC \uC800\uC9C0\uB825\uC774 \uB192\uC740 9mm \uD0C4\uC57D\uC73C\uB85C,
      \uADFC\uAC70\uB9AC \uC804\uD22C\uC5D0 \uC801\uD569\uD569\uB2C8\uB2E4."
  - EntryId: 89377779
    SectionId: 24283221
    Key: item.title.pistolflashlight
    Value: "\uAD8C\uCD1D \uC190\uC804\uB4F1"
  - EntryId: 31912480
    SectionId: 24283221
    Key: item.description.pistolflashlight
    Value: "\uAD8C\uCD1D\uC5D0 \uC7A5\uCC29\uD558\uB294 \uC804\uC220\uC6A9 \uC870\uBA85\uC785\uB2C8\uB2E4.
      \uBAA9\uD45C\uB97C \uBE44\uCD94\uACE0 \uC5B4\uB460 \uC18D\uC5D0 \uC228\uC740
      \uC704\uD5D8\uC744 \uB4DC\uB7EC\uB0C5\uB2C8\uB2E4."
  - EntryId: 25768964
