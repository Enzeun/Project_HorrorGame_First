    Key: item.title.key01
    Value: "\uC5F4\uC1E0 01"
  - EntryId: 54686469
    SectionId: 24283221
    Key: item.description.key01
    Value: "\uC5B4\uB514\uC5D0 \uC4F0\uC774\uB294\uC9C0 \uC54C \uC218 \uC5C6\uB294
