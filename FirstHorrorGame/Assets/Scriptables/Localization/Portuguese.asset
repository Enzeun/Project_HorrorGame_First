  Strings:
  - EntryId: 47251901
    SectionId: 82386491
    Key: Subtitle.start.01
    Value: "Que cansa\xE7o... Preciso descansar um pouco."
  - EntryId: 90593698
    SectionId: 82386491
    Key: Subtitle.start.02
    Value: Vamos entrar logo em casa.
  - EntryId: 54843612
    SectionId: 82386491
    Key: Subtitle.hallway.01
    Value: "Aqui \xE9 a minha casa."
  - EntryId: 31975553
    SectionId: 82386491
    Key: Subtitle.entering.0.turnlight
    Value: Primeiro, vou acender as luzes.
  - EntryId: 79649948
    SectionId: 82386491
    Key: Subtitle.entering.01
    Value: Ufa... Finalmente em casa.
  - EntryId: 35771164
    SectionId: 82386491
    Key: Subtitle.entering.02
    Value: Agora posso descansar um pouco.
  - EntryId: 38887963
    SectionId: 82386491
    Key: Subtitle.dropBackPack.01
    Value: Primeiro, vou largar a bolsa.
  - EntryId: 83938182
    SectionId: 82386491
    Key: Subtitle.entering.03
    Value: "Estou com um pouco de fome... Ser\xE1 que como primeiro?"
  - EntryId: 32038591
    SectionId: 82386491
    Key: Subtitle.Telephone.Scene1.1
    Value: Um telefone desses...
  - EntryId: 94490215
    SectionId: 82386491
    Key: Subtitle.Telephone.Scene1.2
    Value: Isso sempre esteve na minha casa...?
  - EntryId: 90251430
    SectionId: 82386491
    Key: Subtitle.Telephone.Scene1.3
    Value: "Estou cansado demais, melhor n\xE3o ligar pra isso."
  - EntryId: 91861710
    SectionId: 82386491
    Key: Subtitle.goToilet.01
    Value: "De repente, me deu vontade de fazer coc\xF4."
  - EntryId: 85123224
    SectionId: 82386491
    Key: Subtitle.goToSleep.01
    Value: "Ufa... Ser\xE1 que j\xE1 vou dormir?"
  - EntryId: 71467175
    SectionId: 82386491
    Key: Subtitle.goToSleep.Bell.01
    Value: Que susto!!
  - EntryId: 92129515
    SectionId: 82386491
    Key: Subtitle.goToSleep.Bell.02
    Value: "Quem ser\xE1 a esta hora?"
  - EntryId: 96426880
    SectionId: 82386491
    Key: Subtitle.memo.01
    Value: ........
  - EntryId: 38555188
    SectionId: 82386491
    Key: Subtitle.memo.02
    Value: "Deve ser algu\xE9m fazendo uma pegadinha, n\xE9?"
  - EntryId: 18922430
    SectionId: 82386491
    Key: Subtitle.goToSleep.Bell.03
    Value: "Dessa vez voc\xEA n\xE3o escapa!!"
  - EntryId: 80218925
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.1.1
    Value: .................
  - EntryId: 97221779
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.1.2
    Value: "Mas que diabos \xE9 isso...?"
  - EntryId: 50745910
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.1.3
    Value: Deve ser porque estou cansado demais...
  - EntryId: 45707549
    SectionId: 82386491
    Key: Subtitle.hallway.2.01
    Value: "O... o qu\xEA?! Como isso aconteceu?"
  - EntryId: 95546813
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.2.1
    Value: "Olhe para tr\xE1s."
  - EntryId: 54326865
    SectionId: 82386491
    Key: Subtitle.returnhome.1.1
    Value: Mas o que diabos aconteceu?
  - EntryId: 35895386
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.4.1
    Value: Quarto.
  - EntryId: 56045720
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.after.4.1
    Value: "N\xE3o sei o que pode acontecer, melhor levar uma lanterna."
  - EntryId: 39312843
    SectionId: 82386491
    Key: Subtitle.findFlashlight
    Value: Vou procurar uma lanterna antes de entrar.
  - EntryId: 94967976
    SectionId: 82386491
    Key: Subtitle.hallway2.phone
    Value: ...Abra.
  - EntryId: 73121576
    SectionId: 82386491
    Key: Subtitle.hallway2.npc.talk1
    Value: "Desconhecido: Voc\xEA me assustou."
  - EntryId: 62985988
    SectionId: 82386491
    Key: Subtitle.hallway2.npc.talk2
    Value: "Desconhecido: N\xE3o havia nenhuma porta aqui at\xE9 voc\xEA aparecer."
  - EntryId: 12788384
    SectionId: 82386491
    Key: Subtitle.hallway2.npc.talk3
    Value: "Desconhecido: Se passar pela porta\u2026 deve conseguir voltar."
  - EntryId: 60024599
    SectionId: 82386491
    Key: Subtitle.home.npc.talk1
    Value: "Desconhecido: Agora s\xF3 falta abrir a \xFAltima porta."
  - EntryId: 80955542
    SectionId: 82386491
    Key: Subtitle.home.npc.talk2
    Value: "Desconhecido: ................(n\xE3o diz nada)"
  - EntryId: 92999695
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.7.1
    Value: "...........N\xE3o abra a porta."
  - EntryId: 65509164
    SectionId: 82386491
    Key: Subtitle.npc.last.talk1
    Value: "\xC9 esta porta."
  - EntryId: 95681721
    SectionId: 82386491
    Key: Subtitle.Telephone.last.1
    Value: "N\xE3o abra a porta de jeito nenhum."
  - EntryId: 67946711
    SectionId: 82386491
    Key: Subtitle.player.last
    Value: "O... o que \xE9...??"
