  - EntryId: 38887963
    SectionId: 82386491
    Key: Subtitle.dropBackPack.01
    Value: "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u043B\u043E\u0436\u0443
