  Strings:
  - EntryId: 47251901
    SectionId: 82386491
    Key: Subtitle.start.01
    Value: "\u0423\u0444, \u0441\u0438\u043B \u0441\u043E\u0432\u0441\u0435\u043C
      \u043D\u0435\u0442... \u041D\u0430\u0434\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C."
  - EntryId: 90593698
    SectionId: 82386491
    Key: Subtitle.start.02
    Value: "\u0414\u0430\u0432\u0430\u0439 \u0441\u043A\u043E\u0440\u0435\u0435 \u0437\u0430\u0439\u0434\u0451\u043C
