  - EntryId: 54843612
    SectionId: 82386491
    Key: Subtitle.hallway.01
    Value: "\u0412\u043E\u0442 \u043C\u043E\u0439 \u0434\u043E\u043C."
  - EntryId: 31975553
    SectionId: 82386491
    Key: Subtitle.entering.0.turnlight
    Value: "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0434\u043E
