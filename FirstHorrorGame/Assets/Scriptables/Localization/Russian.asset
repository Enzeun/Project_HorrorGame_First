      \u043F\u043E\u0435\u0441\u0442\u044C?"
  - EntryId: 32038591
    SectionId: 82386491
    Key: Subtitle.Telephone.Scene1.1
    Value: "\u0422\u0430\u043A\u043E\u0439 \u0442\u0435\u043B\u0435\u0444\u043E\u043D..."
  - EntryId: 94490215
    SectionId: 82386491
    Key: Subtitle.Telephone.Scene1.2
    Value: "\u041E\u043D \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0442\u043E\u044F\u043B
      \u0443 \u043C\u0435\u043D\u044F \u0434\u043E\u043C\u0430...?"
  - EntryId: 90251430
    SectionId: 82386491
    Key: Subtitle.Telephone.Scene1.3
    Value: "\u042F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0441\u0442\u0430\u043B,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0431 \u044D\u0442\u043E\u043C \u0434\u0443\u043C\u0430\u0442\u044C.
      \u041D\u0435 \u0431\u0443\u0434\u0443 \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F."
  - EntryId: 91861710
    SectionId: 82386491
    Key: Subtitle.goToilet.01
    Value: "\u0412\u0434\u0440\u0443\u0433 \u043F\u0440\u0438\u0441\u043F\u0438\u0447\u0438\u043B\u043E
