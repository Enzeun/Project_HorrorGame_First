  - EntryId: 79649948
    SectionId: 82386491
    Key: Subtitle.entering.01
    Value: "\u0424\u0443\u0445... \u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E
      \u0434\u043E\u043C\u0430."
  - EntryId: 35771164
    SectionId: 82386491
    Key: Subtitle.entering.02
    Value: "\u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0436\u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
