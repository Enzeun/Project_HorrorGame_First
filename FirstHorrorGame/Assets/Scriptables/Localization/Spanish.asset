  Strings:
  - EntryId: 47251901
    SectionId: 82386491
    Key: Subtitle.start.01
    Value: "Qu\xE9 cansancio... Necesito descansar un rato."
  - EntryId: 90593698
    SectionId: 82386491
    Key: Subtitle.start.02
    Value: "Entremos r\xE1pido en casa."
  - EntryId: 54843612
    SectionId: 82386491
    Key: Subtitle.hallway.01
    Value: Esta es mi casa.
  - EntryId: 31975553
    SectionId: 82386491
    Key: Subtitle.entering.0.turnlight
    Value: "Primero deber\xEDa encender las luces."
  - EntryId: 79649948
    SectionId: 82386491
    Key: Subtitle.entering.01
    Value: Uf... Por fin en casa.
  - EntryId: 35771164
    SectionId: 82386491
    Key: Subtitle.entering.02
    Value: Por fin puedo descansar un poco.
  - EntryId: 38887963
    SectionId: 82386491
    Key: Subtitle.dropBackPack.01
    Value: Primero voy a dejar la bolsa.
  - EntryId: 83938182
    SectionId: 82386491
    Key: Subtitle.entering.03
    Value: "Tengo un poco de hambre... \xBFDeber\xEDa comer primero?"
  - EntryId: 32038591
    SectionId: 82386491
    Key: Subtitle.Telephone.Scene1.1
    Value: "Un tel\xE9fono como este..."
  - EntryId: 94490215
    SectionId: 82386491
    Key: Subtitle.Telephone.Scene1.2
    Value: "\xBFEsto siempre estuvo en mi casa...?"
  - EntryId: 90251430
    SectionId: 82386491
    Key: Subtitle.Telephone.Scene1.3
    Value: Estoy demasiado cansado para preocuparme. Mejor lo dejo.
  - EntryId: 91861710
    SectionId: 82386491
    Key: Subtitle.goToilet.01
    Value: De repente me dieron ganas de hacer caca.
  - EntryId: 85123224
    SectionId: 82386491
    Key: Subtitle.goToSleep.01
    Value: "Uf... \xBFYa deber\xEDa irme a dormir?"
  - EntryId: 71467175
    SectionId: 82386491
    Key: Subtitle.goToSleep.Bell.01
    Value: "\xA1\xA1Qu\xE9 susto!!"
  - EntryId: 92129515
    SectionId: 82386491
    Key: Subtitle.goToSleep.Bell.02
    Value: "\xBFQui\xE9n ser\xE1 a esta hora?"
  - EntryId: 96426880
    SectionId: 82386491
    Key: Subtitle.memo.01
    Value: ........
  - EntryId: 38555188
    SectionId: 82386491
    Key: Subtitle.memo.02
    Value: "Seguro es alguien haci\xE9ndome una broma, \xBFno?"
  - EntryId: 18922430
    SectionId: 82386491
    Key: Subtitle.goToSleep.Bell.03
    Value: "\xA1\xA1Esta vez no te saldr\xE1s con la tuya!!"
  - EntryId: 80218925
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.1.1
    Value: .................
  - EntryId: 97221779
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.1.2
    Value: "\xBFQu\xE9 diablos es esto...?"
  - EntryId: 50745910
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.1.3
    Value: Debe ser porque estoy demasiado cansado...
  - EntryId: 45707549
    SectionId: 82386491
    Key: Subtitle.hallway.2.01
    Value: "\xBFQ... qu\xE9?! \xBFC\xF3mo pas\xF3 esto?"
  - EntryId: 95546813
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.2.1
    Value: "Mira detr\xE1s de ti."
  - EntryId: 54326865
    SectionId: 82386491
    Key: Subtitle.returnhome.1.1
    Value: "\xBFQu\xE9 diablos acaba de pasar?"
  - EntryId: 35895386
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.4.1
    Value: Dormitorio.
  - EntryId: 56045720
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.after.4.1
    Value: "No s\xE9 qu\xE9 pueda pasar, mejor llevo una linterna."
  - EntryId: 39312843
    SectionId: 82386491
    Key: Subtitle.findFlashlight
    Value: Voy a buscar una linterna antes de entrar.
  - EntryId: 94967976
    SectionId: 82386491
    Key: Subtitle.hallway2.phone
    Value: "...\xC1brela."
  - EntryId: 73121576
    SectionId: 82386491
    Key: Subtitle.hallway2.npc.talk1
    Value: 'Desconocido: Me asustaste.'
  - EntryId: 62985988
    SectionId: 82386491
    Key: Subtitle.hallway2.npc.talk2
    Value: "Desconocido: No hab\xEDa ninguna puerta aqu\xED hasta que apareciste."
  - EntryId: 12788384
    SectionId: 82386491
    Key: Subtitle.hallway2.npc.talk3
    Value: "Desconocido: Si cruzas la puerta\u2026 deber\xEDas poder volver."
  - EntryId: 60024599
    SectionId: 82386491
    Key: Subtitle.home.npc.talk1
    Value: "Desconocido: Ahora solo falta abrir la \xFAltima puerta."
  - EntryId: 80955542
    SectionId: 82386491
    Key: Subtitle.home.npc.talk2
    Value: 'Desconocido: ................(no dice nada)'
  - EntryId: 92999695
    SectionId: 82386491
    Key: Subtitle.Telephone.answer.7.1
    Value: ...........No abras la puerta.
  - EntryId: 65509164
    SectionId: 82386491
    Key: Subtitle.npc.last.talk1
    Value: Esta es la puerta correcta.
  - EntryId: 95681721
    SectionId: 82386491
    Key: Subtitle.Telephone.last.1
    Value: No abras la puerta por nada del mundo.
  - EntryId: 67946711
    SectionId: 82386491
    Key: Subtitle.player.last
    Value: "\xBFQ... qu\xE9 es...??"
