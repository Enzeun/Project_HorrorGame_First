  - EntryId: 43909112
    SectionId: 60438809
    Key: Objectives.goToSleep.sub1
    Value: Lie down on the bed.
  - EntryId: 63615694
    SectionId: 60438809
    Key: Objectives.examineHallway.title
    Value: Check the hallway.
  - EntryId: 35119893
    SectionId: 60438809
    Key: Objectives.examineHallway.sub01
    Value: Answer the phone at the end of the hallway.
  - EntryId: 12195154
